	<group>
		<op name="UNREACHABLE" placement="statement" sized="false">
			<doc>Marks a point analysis knows execution can't reach</doc>
			<description>Marks a point analysis knows execution can't reach, such as a switch's default case
				when every value has a case.</description>
			<form>unreachable</form>
			<py traits="terminal"/>
		</op>
	</group>

	<group title="The following instructions are only used in SSA form" ssa-only="true">
		<op name="WHILE_SSA" placement="statement" sized="false">
			<operand name="condition_phi">
				<statement/>
			</operand>
			<operand name="condition">
				<boolean/>
			</operand>
			<operand name="body" ast-only="true">
				<statement/>
			</operand>
			<py traits="loop ssa"/>
		</op>

		<op name="DO_WHILE_SSA" placement="statement" sized="false">
			<operand name="body" ast-only="true">
				<statement/>
			</operand>
			<operand name="condition_phi">
				<statement/>
			</operand>
			<operand name="condition">
				<boolean/>
			</operand>
			<py traits="loop ssa"/>
			<rust struct="WhileSsa"/>
		</op>

		<!-- CollectSubExprs visits the update before the body, as with FOR. -->
		<op name="FOR_SSA" placement="statement" sized="false">
			<operand name="init">
				<statement/>
			</operand>
			<operand name="condition_phi">
				<statement/>
			</operand>
			<operand name="condition">
				<boolean/>
			</operand>
			<operand name="update">
				<statement/>
			</operand>
			<operand name="body" ast-only="true">
				<statement/>
			</operand>
			<py traits="loop ssa"/>
			<rust struct="ForLoopSsa"/>
		</op>

		<op name="VAR_INIT_SSA" placement="statement">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<py mixin="_DestVarWritten" traits="set_var ssa"/>
		</op>

		<op name="ASSIGN_MEM_SSA" placement="statement" visit-order="src dest">
			<operand name="dest">
				<bits width="size"/>
			</operand>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<py traits="ssa"/>
		</op>

		<op name="ASSIGN_UNPACK_MEM_SSA" placement="statement" sized="false" visit-order="src dest">
			<operand name="dest" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<py traits="ssa memory"/>
		</op>

		<op name="FORCE_VER_SSA" placement="statement">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src" kind="ssa_variable"/>
			<cpp>
				<rename operand="src" role=""/>
			</cpp>
			<py mixin="_ForceVerVars" traits="ssa"/>
		</op>

		<op name="ASSERT_SSA" placement="statement">
			<operand name="src" kind="ssa_variable"/>
			<operand name="constraint" kind="possible_value_set"/>
			<cpp>
				<rename operand="src" role=""/>
			</cpp>
			<py traits="ssa"/>
		</op>

		<op name="VAR_SSA">
			<operand name="var" kind="ssa_variable"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa_variable_instruction"/>
		</op>

		<op name="VAR_SSA_PARTIAL">
			<operand name="var" kind="variable"/>
			<operand name="dest_version" kind="ssa_version" written="true"/>
			<operand name="prev_version" kind="ssa_version"/>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_version"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_version"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa_variable_instruction"/>
		</op>

		<op name="ARRAY_INDEX_SSA" visit-order="index src">
			<operand name="src">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<operand name="index">
				<integer width="any"/>
			</operand>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="DEREF_SSA">
			<operand name="src">
				<integer width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="DEREF_FIELD_SSA">
			<operand name="src">
				<integer width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<operand name="offset" kind="immediate"/>
			<operand name="member_index" kind="member_index"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="CALL_SSA" placement="either" sized="false" visit-order="params dest">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src_memory" kind="memory_version"/>
			<result>
				<bits width="any"/>
			</result>
			<py traits="localcall ssa"/>
		</op>

		<op name="SYSCALL_SSA" placement="either" sized="false">
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src_memory" kind="memory_version"/>
			<result>
				<bits width="any"/>
			</result>
			<py traits="syscall ssa"/>
		</op>

		<op name="INTRINSIC_SSA" placement="either" sized="false">
			<operand name="intrinsic" kind="intrinsic"/>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src_memory" kind="memory_version"/>
			<result>
				<bits width="any"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="VAR_PHI" placement="statement" sized="false">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src" kind="ssa_variable_list"/>
			<cpp>
				<setter operand="src"/>
			</cpp>
			<py mixin="_DestVarWritten" traits="phi set_var"/>
		</op>

		<op name="MEM_PHI" builder="mem_phi">
			<py>
				<rename operand="dest_memory" to="dest"/>
				<rename operand="src_memory" to="src"/>
			</py>
			<rust>
				<rename operand="dest_memory" to="dest"/>
				<rename operand="src_memory" to="src"/>
			</rust>
		</op>
	</group>

