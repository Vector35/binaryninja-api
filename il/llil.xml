		</operand>
		<operand name="semantic_class" kind="semantic_flag_class">
			<description>The semantic flag class</description>
		</operand>
		<result>
			<boolean/>
		</result>
		<builder>
			<default operand="semantic_class"/>
		</builder>
		<py>
			<rename operand="flag_condition" to="condition"/>
