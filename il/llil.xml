	<group title="The following instructions are only used in SSA form" ssa-only="true">
		<op name="SET_REG_SSA" builder="set_register_ssa" placement="statement">
			<operand name="dest" kind="ssa_register" written="true"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<py traits="set_reg ssa"/>
		</op>

		<op name="SET_REG_SSA_PARTIAL" builder="set_register_ssa_partial" placement="statement">
			<operand name="dest" kind="ssa_register" written="true"/>
			<operand name="partial" kind="register"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<py traits="set_reg ssa">
				<rename operand="dest" to="full_reg"/>
				<rename operand="partial" to="dest"/>
			</py>
			<rust variant="SetRegPartialSsa"/>
		</op>

		<op name="SET_REG_SPLIT_SSA" builder="set_register_split_ssa" placement="statement">
			<operand name="hi" part="REG_SPLIT_DEST_SSA">
				<accessor name="hi_reg" operand="dest"/>
			</operand>
			<operand name="lo" part="REG_SPLIT_DEST_SSA">
				<accessor name="lo_reg" operand="dest"/>
			</operand>
			<operand name="src">
				<bits width="twice-size"/>
			</operand>
			<builder>
				<part-size part="hi" size="size"/>
				<part-size part="lo" size="size"/>
			</builder>
			<py operands="hi lo src" traits="set_reg ssa"/>
			<rust>
				<rename operand="hi" to="dest_expr_high"/>
				<rename operand="lo" to="dest_expr_low"/>
			</rust>
		</op>

		<op name="SET_REG_STACK_REL_SSA" builder="set_register_stack_top_relative_ssa" placement="statement">
			<operand name="stack" part="REG_STACK_DEST_SSA"/>
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="top" part="REG_SSA">
				<accessor name="top_reg" operand="src"/>
			</operand>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<builder>
				<part-size part="stack" size="size"/>
			</builder>
			<py operands="stack dest top src" traits="register_stack ssa"/>
		</op>

		<op name="SET_REG_STACK_ABS_SSA" builder="set_register_stack_absolute_ssa" placement="statement">
			<operand name="stack" part="REG_STACK_DEST_SSA"/>
			<operand name="dest" kind="register" written="true"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<builder>
				<part-size part="stack" size="size"/>
			</builder>
			<py operands="stack dest src" traits="register_stack ssa"/>
		</op>

		<op name="REG_SPLIT_DEST_SSA" placement="part">
			<operand name="dest" kind="ssa_register" written="true"/>
			<py traits="ssa"/>
		</op>

		<op name="REG_STACK_DEST_SSA" placement="part" exposes="dest_stack src_stack">
			<operand name="stack" kind="register_stack"/>
			<operand name="dest_version" kind="ssa_version" written="true"/>
			<operand name="src_version" kind="ssa_version"/>
			<pair name="dest_stack" kind="ssa_register_stack" of="stack" version="dest_version"/>
			<pair name="src_stack" kind="ssa_register_stack" of="stack" version="src_version"/>
			<py traits="register_stack ssa">
				<rename operand="dest_stack" to="dest"/>
				<rename operand="src_stack" to="src"/>
			</py>
		</op>

		<op name="REG_SSA" builder="register_ssa">
			<operand name="src" kind="ssa_register"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="REG_SSA_PARTIAL" builder="register_ssa_partial">
			<operand name="src" kind="ssa_register"/>
			<operand name="partial" kind="register"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa">
				<rename operand="src" to="full_reg"/>
				<rename operand="partial" to="src"/>
			</py>
			<rust variant="RegPartialSsa"/>
		</op>

		<op name="REG_SPLIT_SSA" builder="register_split_ssa">
			<operand name="hi" kind="ssa_register"/>
			<operand name="lo" kind="ssa_register"/>
			<result>
				<bits width="twice-size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="REG_STACK_REL_SSA" builder="register_stack_top_relative_ssa">
			<operand name="src_stack" kind="ssa_register_stack"/>
			<operand name="src">
				<integer width="any"/>
			</operand>
			<operand name="top" part="REG_SSA">
				<accessor name="top_reg" operand="src"/>
			</operand>
			<result>
				<bits width="size"/>
			</result>
			<py operands="src_stack src top" traits="register_stack ssa">
				<rename operand="src_stack" to="stack"/>
			</py>
		</op>

		<op name="REG_STACK_ABS_SSA" builder="register_stack_absolute_ssa">
			<operand name="src_stack" kind="ssa_register_stack"/>
			<operand name="src" kind="register"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="register_stack ssa">
				<rename operand="src_stack" to="stack"/>
			</py>
		</op>

		<op name="REG_STACK_FREE_REL_SSA" builder="register_stack_free_top_relative_ssa" placement="statement" sized="false">
			<operand name="stack" part="REG_STACK_DEST_SSA"/>
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="top" part="REG_SSA">
				<accessor name="top_reg" operand="src"/>
			</operand>
			<builder>
				<part-size part="stack" size="0"/>
			</builder>
			<py operands="stack dest top" traits="register_stack ssa"/>
		</op>

		<op name="REG_STACK_FREE_ABS_SSA" builder="register_stack_free_absolute_ssa" placement="statement" sized="false">
			<operand name="stack" part="REG_STACK_DEST_SSA"/>
			<operand name="dest" kind="register"/>
			<py operands="stack dest" traits="register_stack ssa"/>
		</op>

		<op name="SET_FLAG_SSA" placement="statement" sized="false">
			<operand name="dest" kind="ssa_flag" written="true"/>
			<operand name="src">
				<boolean/>
			</operand>
			<py traits="ssa"/>
		</op>

		<op name="ASSERT_SSA" placement="statement">
			<operand name="src" kind="ssa_register"/>
			<operand name="constraint" kind="possible_value_set"/>
			<py traits="ssa"/>
		</op>

		<op name="FORCE_VER_SSA" placement="statement">
			<operand name="dest" kind="ssa_register" written="true"/>
			<operand name="src" kind="ssa_register"/>
			<py traits="ssa"/>
			<rust variant="ForceVersionSsa"/>
		</op>

		<op name="FLAG_SSA" sized="false">
			<operand name="src" kind="ssa_flag"/>
			<result>
				<boolean/>
			</result>
			<py traits="ssa"/>
			<rust variant="Flag"/>
		</op>

		<op name="FLAG_BIT_SSA">
			<operand name="src" kind="ssa_flag"/>
			<operand name="bit" kind="index"/>
			<result>
				<integer width="size"/>
			</result>
			<py traits="ssa"/>
			<rust variant="FlagBit"/>
		</op>

		<op name="CALL_SSA" placement="statement" sized="false">
			<operand name="output_expr" part="CALL_OUTPUT_SSA"/>
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="stack" part="CALL_STACK_SSA"/>
			<operand name="param" part="CALL_PARAM"/>
			<builder params="output dest params stack_reg dest_memory src_memory"/>
			<py operands="output dest stack params" traits="localcall ssa">
				<rename operand="src_memory" to="stack_memory"/>
			</py>
		</op>

		<op name="SYSCALL_SSA" builder="system_call_ssa" placement="statement" sized="false">
			<operand name="output_expr" part="CALL_OUTPUT_SSA"/>
			<operand name="stack" part="CALL_STACK_SSA"/>
			<operand name="param" part="CALL_PARAM"/>
			<builder params="output params stack_reg dest_memory src_memory"/>
			<py operands="output stack_reg src_memory params" traits="syscall ssa">
				<rename operand="src_memory" to="stack_memory"/>
			</py>
			<rust>
				<rename operand="output_expr" suffix="false"/>
			</rust>
		</op>

		<op name="TAILCALL_SSA" builder="tail_call_ssa" placement="statement" sized="false">
			<operand name="output_expr" part="CALL_OUTPUT_SSA"/>
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="stack" part="CALL_STACK_SSA"/>
			<operand name="param" part="CALL_PARAM"/>
			<builder params="output dest params stack_reg dest_memory src_memory"/>
			<py operands="output dest stack params" traits="tailcall ssa">
				<rename operand="src_memory" to="stack_memory"/>
			</py>
			<rust variant="TailCallSsa" marker="CallSsa"/>
		</op>

		<op name="CALL_PARAM" placement="part" exposes="params">
			<operand name="params" kind="expr_list">
				<bits width="any"/>
				<description>The parameters</description>
			</operand>
			<py mixin="_ParamListFormatting" traits="ssa">
				<rename operand="params" to="src"/>
			</py>
			<rust variant="CallParamSsa"/>
		</op>

		<op name="CALL_STACK_SSA" placement="part" exposes="stack_reg src_memory">
			<operand name="stack_reg" kind="ssa_register"/>
			<operand name="src_memory" kind="memory_version"/>
			<cpp>
				<parent-usage operand="src_memory" name="StackMemoryVersion"/>
			</cpp>
			<py mixin="_CallStackSsaFormatting" traits="ssa">
				<rename operand="stack_reg" to="src"/>
			</py>
			<rust>
				<rename operand="stack_reg" to="source_reg"/>
			</rust>
		</op>

		<op name="CALL_OUTPUT_SSA" placement="part" exposes="output dest_memory">
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="output" kind="ssa_register_list" written="true"/>
			<cpp>
				<parent-usage operand="dest_memory" name="OutputMemoryVersion"/>
			</cpp>
			<py mixin="_CallOutputSsaFormatting" traits="ssa">
				<rename operand="output" to="dest"/>
			</py>
			<rust>
				<rename operand="output" to="dest_regs"/>
			</rust>
		</op>

		<op name="SEPARATE_PARAM_LIST_SSA" placement="part" sized="false" part-of="CALL_PARAM">
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<builder/>
			<py mixin="_ParamListFormatting" traits="ssa">
				<rename operand="params" to="src"/>
			</py>
		</op>

		<op name="SHARED_PARAM_SLOT_SSA" placement="part" sized="false" part-of="SEPARATE_PARAM_LIST_SSA">
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<builder/>
			<py mixin="_ParamListFormatting" traits="ssa">
				<rename operand="params" to="src"/>
			</py>
		</op>

		<op name="MEMORY_INTRINSIC_OUTPUT_SSA" placement="part" exposes="output dest_memory">
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="output" kind="ssa_register_or_flag_list" written="true"/>
			<cpp>
				<parent-usage operand="dest_memory" name="OutputMemoryVersion"/>
				<parent-usage operand="output" name="OutputMemoryIntrinsic"/>
			</cpp>
			<py mixin="_MemoryIntrinsicOutputSsaFormatting" traits="ssa"/>
		</op>

		<op name="LOAD_SSA"/>

		<op name="STORE_SSA">
			<builder params="dest src dest_memory src_memory"/>
		</op>

		<op name="INTRINSIC_SSA" placement="statement" sized="false">
			<operand name="output" kind="ssa_register_or_flag_list" written="true"/>
			<operand name="intrinsic" kind="intrinsic"/>
			<operand name="param" part="CALL_PARAM"/>
			<py traits="ssa"/>
			<rust variant="Intrinsic"/>
		</op>

		<op name="MEMORY_INTRINSIC_SSA" placement="statement" sized="false">
			<operand name="output_expr" part="MEMORY_INTRINSIC_OUTPUT_SSA"/>
			<operand name="intrinsic" kind="intrinsic"/>
			<operand name="param" part="CALL_PARAM"/>
			<operand name="src_memory" kind="memory_version"/>
			<builder params="output intrinsic params dest_memory src_memory"/>
			<py operands="output intrinsic params dest_memory src_memory" traits="ssa"/>
			<rust>
				<rename operand="output_expr" suffix="false"/>
			</rust>
		</op>

		<op name="REG_PHI" builder="register_phi" placement="statement" sized="false">
			<operand name="dest" kind="ssa_register" written="true"/>
			<operand name="src" kind="ssa_register_list"/>
			<py traits="phi"/>
		</op>

		<op name="REG_STACK_PHI" builder="register_stack_phi" placement="statement" sized="false">
			<operand name="dest" kind="ssa_register_stack" written="true"/>
			<operand name="src" kind="ssa_register_stack_list"/>
			<py traits="register_stack phi"/>
		</op>

		<op name="FLAG_PHI" placement="statement" sized="false">
			<operand name="dest" kind="ssa_flag" written="true"/>
			<operand name="src" kind="ssa_flag_list"/>
			<py traits="phi"/>
		</op>

		<op name="MEM_PHI">
			<rust>
				<type operand="dest_memory" is="usize"/>
			</rust>
		</op>
