	<group title="Floating point">
		<op name="FADD" flags="true">
			<description>Adds <ref name="left"/> and <ref name="right"/> as floating point values.
				Without flags, renders as <code><ref name="left"/> f+ <ref name="right"/></code>.</description>
			<form>fadd<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
		</op>

		<op name="FSUB" flags="true">
			<description>Subtracts <ref name="right"/> from <ref name="left"/> as floating point
				values. Without flags, renders as <code><ref name="left"/> f- <ref name="right"/></code>.</description>
			<form>fsub<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
		</op>

		<op name="FMUL" flags="true">
			<description>Multiplies <ref name="left"/> by <ref name="right"/> as floating point
				values. Without flags, renders as <code><ref name="left"/> f* <ref name="right"/></code>.</description>
			<form>fmul<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
		</op>

		<op name="FDIV" flags="true">
			<description>Divides <ref name="left"/> by <ref name="right"/> as floating point values.
				Without flags, renders as <code><ref name="left"/> f/ <ref name="right"/></code>.</description>
			<form>fdiv<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
		</op>

