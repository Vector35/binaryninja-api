<?xml version="1.0" encoding="UTF-8"?>
<il xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="il.xsd" level="llil" slots="4" flags="true">
	<shape name="binary">
		<rust marker="BinaryOp"/>
	</shape>
	<shape name="comparison">
		<rust marker="Condition"/>
	</shape>
	<shape name="unary">
		<rust marker="UnaryOp"/>
	</shape>
	<shape name="carry">
		<rust marker="BinaryOpCarry"/>
	</shape>
	<shape name="shift">
		<rust marker="BinaryOp">
			<lift operand="right" width="size"/>
		</rust>
	</shape>
	<shape name="rotate_carry">
		<rust marker="BinaryOpCarry">
			<lift operand="right" width="size"/>
		</rust>
	</shape>
	<shape name="double_precision_division">
		<rust marker="BinaryOp"/>
	</shape>
	<shape name="float_binary">
		<rust marker="BinaryOp"/>
	</shape>
	<shape name="float_comparison">
		<rust marker="Condition"/>
	</shape>
	<shape name="float_unary">
		<rust marker="UnaryOp"/>
	</shape>
	<shape name="constant">
		<py base="ConstantBase" trait="constant" decodes="constant"/>
	</shape>

	<rust-marker name="BinaryOp" as="as_binary_op">
		<rename operand="left" suffix="false"/>
		<rename operand="right" suffix="false"/>
	</rust-marker>
	<rust-marker name="BinaryOpCarry" as="as_binary_op_carry">
		<rename operand="left" suffix="false"/>
		<rename operand="right" suffix="false"/>
		<rename operand="carry" suffix="false"/>
	</rust-marker>
	<rust-marker name="Call" handwritten="true">
		<rename operand="dest" to="target"/>
	</rust-marker>
	<rust-marker name="CallSsa">
		<rename operand="dest" to="target"/>
		<rename operand="output_expr" suffix="false"/>
	</rust-marker>
	<rust-marker name="Condition" as="as_cmp_op">
		<rename operand="left" suffix="false"/>
		<rename operand="right" suffix="false"/>
	</rust-marker>
	<rust-marker name="Const">
		<rename operand="constant" to="value"/>
		<accessor name="value"/>
	</rust-marker>
	<rust-marker name="Extern">
		<accessor name="value"/>
	</rust-marker>
	<rust-marker name="Flag" handwritten="true"/>
	<rust-marker name="FlagBit" handwritten="true"/>
	<rust-marker name="FloatConst">
		<accessor name="float_value"/>
	</rust-marker>
	<rust-marker name="Intrinsic" handwritten="true">
		<rename operand="output" to="outputs"/>
		<rename operand="param" to="inputs"/>
	</rust-marker>
	<rust-marker name="NoArgs" handwritten="true"/>
	<rust-marker name="RegPartialSsa">
		<accessor name="source_reg"/>
	</rust-marker>
	<rust-marker name="SetRegPartialSsa">
		<accessor name="dest_reg"/>
	</rust-marker>
	<rust-marker name="UnaryOp" as="as_unary_op">
		<rename operand="src" to="operand"/>
	</rust-marker>

	<op name="NOP">
		<rust marker="NoArgs"/>
	</op>

	<op name="SET_REG" builder="set_register" placement="statement" flags="true" ssa-form="SET_REG_SSA">
		<description>Sets register <ref name="dest"/> to <ref name="src"/>.</description>
		<form><ref name="dest"/> = <ref name="src"/> <flags/></form>
		<operand name="dest" kind="register" written="true">
			<description>The register to set</description>
		</operand>
		<operand name="src">
			<bits width="size"/>
			<description>The value to set it to</description>
		</operand>
		<py builder="set_reg" traits="set_reg">
			<param operand="dest" name="reg"/>
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="SET_REG_SPLIT" builder="set_register_split" placement="statement" flags="true" ssa-form="SET_REG_SPLIT_SSA">
		<description>Sets the register pair <ref name="hi"/>:<ref name="lo"/> to <ref name="src"/>,
			a value twice the size of each register.</description>
		<size>The size of each register in bytes</size>
		<form><ref name="hi"/>:<ref name="lo"/> = <ref name="src"/> <flags/></form>
		<operand name="hi" kind="register" written="true">
			<description>The register that receives the high half</description>
		</operand>
		<operand name="lo" kind="register" written="true">
			<description>The register that receives the low half</description>
		</operand>
		<operand name="src">
			<bits width="twice-size"/>
			<description>The value to set the pair to</description>
		</operand>
		<py builder="set_reg_split" traits="set_reg">
			<param operand="src" name="value"/>
		</py>
		<rust>
			<rename operand="hi" to="dest_reg_high"/>
			<rename operand="lo" to="dest_reg_low"/>
		</rust>
	</op>

	<op name="SET_FLAG" placement="statement" sized="false" ssa-form="SET_FLAG_SSA">
		<description>Sets flag <ref name="dest"/> to <ref name="src"/>.</description>
		<form><ref name="dest"/> = <ref name="src"/></form>
		<operand name="dest" kind="flag" written="true">
			<description>The flag to set</description>
		</operand>
		<operand name="src">
			<boolean/>
			<description>The value to set it to</description>
		</operand>
		<py>
			<param operand="dest" name="flag"/>
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="SET_REG_STACK_REL" builder="set_register_stack_top_relative" placement="statement" flags="true" ssa-form="SET_REG_STACK_REL_SSA">
		<description>Sets the register stack entry at position <ref name="dest"/> from the top of
			<ref name="dest_stack"/> to <ref name="src"/>.</description>
		<form><ref name="dest_stack"/>[<ref name="dest"/>] = <ref name="src"/> <flags/></form>
		<operand name="dest_stack" kind="register_stack" written="true">
			<description>The register stack</description>
		</operand>
		<operand name="dest">
			<integer width="any"/>
			<description>The position of the entry, relative to the top of the stack</description>
		</operand>
		<operand name="src">
			<bits width="size"/>
			<description>The value to set the entry to</description>
		</operand>
		<py builder="set_reg_stack_top_relative" traits="register_stack">
			<rename operand="dest_stack" to="stack"/>
			<param operand="dest_stack" name="reg_stack"/>
			<param operand="dest" name="entry"/>
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="REG_STACK_PUSH" builder="register_stack_push" placement="statement" flags="true" ssa-form="expanded">
		<description>Pushes <ref name="src"/> onto the top of register stack <ref name="dest_stack"/>.</description>
		<form><ref name="dest_stack"/>.push<flags/>(<ref name="src"/>)</form>
		<operand name="dest_stack" kind="register_stack" written="true">
			<description>The register stack</description>
		</operand>
		<operand name="src">
			<bits width="size"/>
			<description>The value to push</description>
		</operand>
		<py builder="reg_stack_push" traits="register_stack">
			<rename operand="dest_stack" to="stack"/>
			<param operand="dest_stack" name="reg_stack"/>
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="ASSERT" placement="statement">
		<description>Asserts that register <ref name="src"/> holds one of the values
			<ref name="constraint"/> allows. Core inserts it where a user has set possible values for
			<ref name="src"/>.</description>
		<size>The size of the register in bytes</size>
		<form>ASSERT(<ref name="src"/>, <ref name="constraint"/>)</form>
		<operand name="src" kind="register">
			<description>The register to constrain</description>
		</operand>
		<operand name="constraint" kind="possible_value_set">
			<description>The values the register may hold</description>
		</operand>
		<py builder="assert_expr"/>
	</op>

	<op name="FORCE_VER" placement="statement">
		<description>Gives register <ref name="dest"/> a new SSA version, as though it were assigned
			its own value. MLIL can then use this as a new variable definition site.</description>
		<size>The size of the register in bytes</size>
		<form>FORCE_VER(<ref name="dest"/>)</form>
		<operand name="dest" kind="register" written="true">
			<description>The register to give a new version</description>
		</operand>
		<rust variant="ForceVersion"/>
	</op>

	<op name="LOAD" flags="true">
		<py>
			<param operand="src" name="addr"/>
		</py>
		<rust marker="Load"/>
	</op>

	<op name="STORE" flags="true">
		<py>
			<param operand="dest" name="addr"/>
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="PUSH" shape="unary" placement="statement" flags="true" ssa-form="expanded">
		<description>Writes <ref name="src"/> to the stack, adjusting the stack pointer by
			<ref name="size"/>.</description>
		<form>push<size/><flags/>(<ref name="src"/>)</form>
		<operand name="src">
			<bits width="size"/>
			<description>The value to push</description>
		</operand>
		<py traits="stack_operation">
			<param operand="src" name="value"/>
		</py>
	</op>

	<op name="POP" flags="true" ssa-form="expanded">
		<description>Reads <ref name="size"/> bytes from the stack, adjusting the stack pointer by
			<ref name="size"/>.</description>
		<form>pop<size/><flags/></form>
		<result>
			<bits width="size"/>
		</result>
		<py traits="stack_operation"/>
	</op>

	<op name="REG" builder="register" ssa-form="REG_SSA">
		<description>Reads register <ref name="src"/>.</description>
		<form><ref name="src"/></form>
		<operand name="src" kind="register">
			<description>The register to read</description>
		</operand>
		<result>
			<bits width="size"/>
		</result>
		<py builder="reg">
			<param operand="src" name="reg"/>
		</py>
	</op>

	<op name="REG_SPLIT" builder="register_split" ssa-form="REG_SPLIT_SSA">
		<description>Reads the register pair <ref name="hi"/>:<ref name="lo"/> as one value, twice
			the size of each register.</description>
		<size>The size of each register in bytes</size>
		<form><ref name="hi"/>:<ref name="lo"/></form>
		<operand name="hi" kind="register">
			<description>The register holding the high half</description>
		</operand>
		<operand name="lo" kind="register">
			<description>The register holding the low half</description>
		</operand>
		<result>
			<bits width="twice-size"/>
		</result>
		<py builder="reg_split"/>
	</op>

	<op name="REG_STACK_REL" builder="register_stack_top_relative" ssa-form="REG_STACK_REL_SSA">
		<description>Reads the register stack entry at position <ref name="src"/> from the top of
			<ref name="src_stack"/>.</description>
		<form><ref name="src_stack"/>[<ref name="src"/>]</form>
		<operand name="src_stack" kind="register_stack">
			<description>The register stack</description>
		</operand>
		<operand name="src">
			<integer width="any"/>
			<description>The position of the entry, relative to the top of the stack</description>
		</operand>
		<result>
			<bits width="size"/>
		</result>
		<py builder="reg_stack_top_relative" traits="register_stack">
			<rename operand="src_stack" to="stack"/>
			<param operand="src_stack" name="reg_stack"/>
			<param operand="src" name="entry"/>
		</py>
	</op>

	<op name="REG_STACK_POP" builder="register_stack_pop" flags="true" ssa-form="expanded">
		<description>Reads the top entry of register stack <ref name="src_stack"/> and removes it
			from the stack.</description>
		<form><ref name="src_stack"/>.pop<flags/></form>
		<operand name="src_stack" kind="register_stack">
			<description>The register stack</description>
		</operand>
		<result>
			<bits width="size"/>
		</result>
		<py builder="reg_stack_pop" traits="register_stack">
			<rename operand="src_stack" to="stack"/>
			<param operand="src_stack" name="reg_stack"/>
		</py>
	</op>

	<op name="REG_STACK_FREE_REG" builder="register_stack_free_reg" placement="statement" sized="false" ssa-form="REG_STACK_FREE_REL_SSA REG_STACK_FREE_ABS_SSA">
		<description>Frees register <ref name="dest"/> in its register stack, without changing which
			register is at the top of the stack.</description>
		<form>__free_slot(<ref name="dest"/>)</form>
		<operand name="dest" kind="register">
			<description>The register to free</description>
		</operand>
		<py builder="reg_stack_free_reg" traits="register_stack">
			<param operand="dest" name="reg"/>
		</py>
	</op>

	<op name="REG_STACK_FREE_REL" builder="register_stack_free_top_relative" placement="statement" sized="false" ssa-form="REG_STACK_FREE_REL_SSA">
		<description>Frees the register stack entry at position <ref name="dest"/> from the top of
			<ref name="dest_stack"/>.</description>
		<form>__free_slot(<ref name="dest_stack"/>[<ref name="dest"/>])</form>
		<operand name="dest_stack" kind="register_stack">
			<description>The register stack</description>
		</operand>
		<operand name="dest">
			<integer width="any"/>
			<description>The position of the entry, relative to the top of the stack</description>
		</operand>
		<py builder="reg_stack_free_top_relative" traits="register_stack">
			<rename operand="dest_stack" to="stack"/>
			<param operand="dest_stack" name="reg_stack"/>
			<param operand="dest" name="entry"/>
		</py>
	</op>

	<op name="CONST"/>

	<op name="CONST_PTR">
		<rust marker="Const"/>
	</op>

	<op name="EXTERN_PTR">
		<cpp>
			<type operand="constant" is="size_t"/>
			<type operand="offset" is="size_t"/>
		</cpp>
		<rust marker="Extern">
			<rename operand="constant" to="value"/>
		</rust>
	</op>

	<op name="FLOAT_CONST">
		<rust>
			<rename operand="constant" to="raw_value"/>
		</rust>
	</op>

	<op name="FLAG" sized="false" ssa-form="FLAG_SSA">
		<description>Reads flag <ref name="src"/>.</description>
		<form><ref name="src"/></form>
		<operand name="src" kind="flag">
			<description>The flag to read</description>
		</operand>
		<result>
			<boolean/>
		</result>
		<py>
			<param operand="src" name="flag"/>
		</py>
	</op>

	<op name="FLAG_BIT" ssa-form="FLAG_BIT_SSA">
		<description>An integer holding the value of flag <ref name="src"/> at bit
			<ref name="bit"/>, with every other bit clear.</description>
		<form>flagbit<size/>(<ref name="src"/>, <ref name="bit"/>)</form>
		<operand name="src" kind="flag">
			<description>The flag to read</description>
		</operand>
		<operand name="bit" kind="index">
			<description>The index of the bit that holds the flag's value</description>
		</operand>
		<result>
			<integer width="size"/>
		</result>
		<py>
			<param operand="src" name="flag"/>
		</py>
	</op>

	<op name="ADD" flags="true">
		<description>Adds <ref name="left"/> and <ref name="right"/>. Without flags, renders as
			<code><ref name="left"/> + <ref name="right"/></code>.</description>
		<form>add<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="ADC" flags="true"/>

	<op name="SUB" flags="true">
		<description>Subtracts <ref name="right"/> from <ref name="left"/>. Without flags, renders as
			<code><ref name="left"/> - <ref name="right"/></code>.</description>
		<form>sub<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="SBB" flags="true"/>

	<op name="AND" flags="true">
		<description>The bitwise and of <ref name="left"/> and <ref name="right"/>. Without flags,
			renders as <code><ref name="left"/> &amp; <ref name="right"/></code>, or as
			<code><ref name="left"/> &amp;&amp; <ref name="right"/></code> when <ref name="size"/> is
			0.</description>
		<form>and<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="OR" flags="true">
		<description>The bitwise or of <ref name="left"/> and <ref name="right"/>. Without flags,
			renders as <code><ref name="left"/> | <ref name="right"/></code>, or as
			<code><ref name="left"/> || <ref name="right"/></code> when <ref name="size"/> is
			0.</description>
		<form>or<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="XOR" flags="true">
		<description>The bitwise exclusive or of <ref name="left"/> and <ref name="right"/>. Without
			flags, renders as <code><ref name="left"/> ^ <ref name="right"/></code>.</description>
		<form>xor<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="LSL" flags="true">
		<description>Shifts <ref name="left"/> left by <ref name="right"/> bits. Without flags,
			renders as <code><ref name="left"/> &lt;&lt; <ref name="right"/></code>.</description>
		<form>lsl<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="LSR" flags="true">
		<description>Shifts <ref name="left"/> logically right by <ref name="right"/> bits. Without
			flags, renders as <code><ref name="left"/> u&gt;&gt; <ref name="right"/></code>.</description>
		<form>lsr<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="ASR" flags="true">
		<description>Shifts <ref name="left"/> arithmetically right by <ref name="right"/> bits.
			Without flags, renders as <code><ref name="left"/> s&gt;&gt; <ref name="right"/></code>.</description>
		<form>asr<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="ROL" flags="true"/>

	<op name="RLC" flags="true"/>

	<op name="ROR" flags="true"/>

	<op name="RRC" flags="true"/>

	<op name="MUL" flags="true">
		<description>Multiplies <ref name="left"/> by <ref name="right"/>. The operands and the result
			are all <ref name="size"/> bytes, so the upper half of the product is discarded. Without
			flags, renders as <code><ref name="left"/> * <ref name="right"/></code>.</description>
		<form>mul<size/><flags/>(<ref name="left"/>, <ref name="right"/>)</form>
	</op>

	<op name="MULU_DP" flags="true"/>

	<op name="MULS_DP" flags="true"/>

	<op name="DIVU" flags="true"/>

	<op name="DIVU_DP" flags="true"/>

	<op name="DIVS" flags="true"/>

	<op name="DIVS_DP" flags="true"/>

	<op name="MODU" flags="true"/>

	<op name="MODU_DP" flags="true"/>

	<op name="MODS" flags="true"/>

	<op name="MODS_DP" flags="true"/>

	<op name="NEG" flags="true"/>

	<op name="NOT" flags="true"/>

	<op name="SX" flags="true"/>

	<op name="ZX" flags="true"/>

	<op name="LOW_PART" flags="true"/>

	<op name="JUMP">
		<rust>
			<rename operand="dest" to="target"/>
		</rust>
	</op>

	<op name="JUMP_TO">
		<rust>
			<rename operand="dest" to="target"/>
			<rename operand="targets" to="target_list"/>
		</rust>
	</op>

	<op name="CALL" placement="statement" sized="false">
		<description>Calls <ref name="dest"/>. On architectures without a link register, this pushes
			the address of the next instruction onto the stack, then jumps to
			<ref name="dest"/>.</description>
		<form>call(<ref name="dest"/>)</form>
		<operand name="dest">
			<integer width="any"/>
			<description>The address to call</description>
		</operand>
		<py traits="localcall"/>
	</op>

	<op name="CALL_STACK_ADJUST" placement="statement" sized="false">
		<description>Calls <ref name="dest"/>, then once the callee returns, adds
			<ref name="stack_adjustment"/> to the stack pointer and adjusts the top of each
			register stack by its amount in <ref name="reg_stack_adjustments"/>.</description>
		<form>call(<ref name="dest"/>), stack += <ref name="stack_adjustment"/></form>
		<operand name="dest">
			<integer width="any"/>
			<description>The address to call</description>
		</operand>
		<operand name="stack_adjustment" kind="immediate" signed="true">
			<description>The amount to add to the stack pointer once the callee returns</description>
		</operand>
		<operand name="reg_stack_adjustments" kind="register_stack_adjustments">
			<description>The amount to move the top of each register stack by once the callee returns</description>
		</operand>
		<builder>
			<default operand="reg_stack_adjustments"/>
		</builder>
		<py traits="localcall">
			<param operand="stack_adjustment" name="stack_adjust"/>
		</py>
		<rust variant="Call">
			<rename operand="stack_adjustment" to="stack_adjust"/>
		</rust>
	</op>

	<op name="TAILCALL" builder="tail_call" placement="statement" sized="false">
		<description>Jumps to <ref name="dest"/> as a tail call.</description>
		<form>&lt;return&gt; tailcall(<ref name="dest"/>)</form>
		<operand name="dest">
			<integer width="any"/>
			<description>The address to jump to</description>
		</operand>
		<py builder="tailcall" traits="tailcall"/>
		<rust variant="TailCall" marker="Call"/>
	</op>

	<op name="RET" builder="return" placement="statement" sized="false">
		<description>Returns from the function by jumping to <ref name="dest"/>.</description>
		<form>&lt;return&gt; jump(<ref name="dest"/>)</form>
		<operand name="dest">
			<integer width="any"/>
			<description>The address to return to</description>
		</operand>
		<py builder="ret" traits="return"/>
		<rust>
			<rename operand="dest" to="target"/>
		</rust>
	</op>

	<op name="NORET">
		<rust variant="NoRet" marker="NoArgs" lifter="no_ret"/>
	</op>

	<op name="IF" placement="statement" sized="false">
		<operand name="condition">
			<boolean/>
		</operand>
		<operand name="true" kind="target"/>
		<operand name="false" kind="target"/>
		<builder handwritten="true"/>
		<py builder="if_expr" traits="control_flow">
			<param operand="condition" name="operand"/>
			<param operand="true" name="t"/>
			<param operand="false" name="f"/>
		</py>
		<rust>
			<rename operand="condition" suffix="false"/>
		</rust>
	</op>

	<op name="GOTO" placement="statement" sized="false">
		<operand name="dest" kind="target"/>
		<builder handwritten="true"/>
		<cpp>
			<rename operand="dest" to="Target"/>
		</cpp>
		<py traits="terminal">
			<param operand="dest" name="label"/>
		</py>
		<rust>
			<rename operand="dest" to="target"/>
		</rust>
	</op>

	<op name="FLAG_COND" builder="flag_condition" sized="false">
		<doc>Valid only in Lifted IL</doc>
		<description>Tests the flag condition <ref name="flag_condition"/>, using semantic flag class
			<ref name="semantic_class"/> where given.</description>
		<form><ref name="flag_condition"/></form>
		<operand name="flag_condition" kind="flag_condition">
