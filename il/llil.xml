			<description>An unimplemented instruction or value.</description>
			<form>unimplemented</form>
			<fixed operand="unknown" value="0"/>
		</builder>
		<builder name="unknown">
			<description>A value that can't be known at analysis time, such as a flag that depends on
				runtime state. It doesn't produce the warning an unimplemented expression
				does.</description>
			<form>unknown</form>
			<fixed operand="unknown" value="1"/>
		</builder>
		<rust marker="NoArgs">
			<lifter builder="unimplemented" name="unimplemented"/>
