	<group title="The following instructions are only used in SSA form" ssa-only="true">
		<op name="SET_VAR_SSA" placement="statement">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<py mixin="_SetVarSsaVars" traits="set_var ssa"/>
		</op>

		<op name="SET_VAR_SSA_FIELD" placement="statement">
			<operand name="var" kind="variable"/>
			<operand name="dest_version" kind="ssa_version" written="true"/>
			<operand name="prev_version" kind="ssa_version"/>
			<operand name="offset" kind="immediate"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_version"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_version"/>
			<py mixin="_SetVarFieldVars" traits="set_var ssa"/>
		</op>

		<op name="SET_VAR_SPLIT_SSA" builder="set_var_ssa_split" placement="statement">
			<operand name="high" kind="ssa_variable" written="true"/>
			<operand name="low" kind="ssa_variable" written="true"/>
			<operand name="src">
				<bits width="twice-size"/>
			</operand>
			<py mixin="_SetVarSplitSsaVars" traits="set_var ssa"/>
		</op>

		<op name="SET_VAR_ALIASED" placement="statement">
			<operand name="var" kind="variable"/>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="prev_memory" kind="memory_version"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_memory"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_memory"/>
			<py mixin="_SetVarSsaVars" traits="set_var ssa"/>
		</op>

		<op name="SET_VAR_ALIASED_FIELD" placement="statement">
			<operand name="var" kind="variable"/>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="prev_memory" kind="memory_version"/>
			<operand name="offset" kind="immediate"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_memory"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_memory"/>
			<py mixin="_SetVarFieldVars" traits="set_var ssa"/>
			<rust struct="SetVarSsaField"/>
		</op>

		<op name="VAR_SSA">
			<operand name="src" kind="ssa_variable"/>
			<result>
				<bits width="size"/>
			</result>
			<py operands="var" traits="ssa_variable_instruction">
				<alias name="var" of="src"/>
			</py>
		</op>

		<op name="VAR_SSA_FIELD">
			<operand name="src" kind="ssa_variable"/>
			<operand name="offset" kind="immediate"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="VAR_ALIASED">
			<operand name="var" kind="variable"/>
			<operand name="src_memory" kind="memory_version"/>
			<pair name="src" kind="ssa_variable" of="var" version="src_memory"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa aliased_variable_instruction"/>
			<rust struct="VarSsa"/>
		</op>

		<op name="VAR_ALIASED_FIELD">
			<operand name="var" kind="variable"/>
			<operand name="src_memory" kind="memory_version"/>
			<operand name="offset" kind="immediate"/>
			<pair name="src" kind="ssa_variable" of="var" version="src_memory"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="ssa"/>
			<rust struct="VarSsaField"/>
		</op>

		<op name="VAR_SPLIT_SSA">
			<operand name="high" kind="ssa_variable"/>
			<operand name="low" kind="ssa_variable"/>
			<result>
				<bits width="twice-size"/>
			</result>
			<py traits="ssa"/>
		</op>

		<op name="ASSERT_SSA" placement="statement">
			<operand name="src" kind="ssa_variable"/>
			<operand name="constraint" kind="possible_value_set"/>
			<py traits="ssa"/>
		</op>

		<op name="FORCE_VER_SSA" placement="statement">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src" kind="ssa_variable"/>
			<operand name="reason" kind="force_version_reason"/>
			<py mixin="_ForceVerSsaVars" traits="ssa"/>
		</op>

		<op name="CALL_SSA" shape="call_ssa" placement="statement" sized="false" visit-order="dest output_expr params">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<builder params="output_exprs dest params dest_memory src_memory"/>
			<py operands="output dest_memory dest params src_memory" traits="localcall ssa"/>
			<rust operands="output_exprs dest params src_memory"/>
		</op>

		<op name="CALL_UNTYPED_SSA" shape="call_ssa" placement="statement" sized="false" visit-order="dest output_expr param stack">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="param" part="CALL_PARAM_SSA"/>
			<operand name="stack" visited="false">
				<integer width="any"/>
			</operand>
			<builder params="output_exprs dest params dest_memory src_memory stack"/>
			<py operands="output dest_memory dest params src_memory stack" traits="localcall ssa">
				<rename operand="src_memory" to="params_src_memory"/>
			</py>
			<rust operands="output_exprs dest params stack"/>
		</op>

		<op name="SYSCALL_SSA" shape="call_ssa" placement="statement" sized="false">
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<builder params="output_exprs params dest_memory src_memory"/>
			<py operands="output dest_memory params src_memory" traits="syscall ssa"/>
			<rust operands="output_exprs params src_memory"/>
		</op>

		<op name="SYSCALL_UNTYPED_SSA" shape="call_ssa" placement="statement" sized="false">
			<operand name="param" part="CALL_PARAM_SSA"/>
			<operand name="stack" visited="false">
				<integer width="any"/>
			</operand>
			<builder params="output_exprs params dest_memory src_memory stack"/>
			<py operands="output dest_memory params src_memory stack" traits="syscall ssa">
				<rename operand="src_memory" to="params_src_memory"/>
			</py>
			<rust operands="output_exprs params stack"/>
		</op>

		<op name="TAILCALL_SSA" builder="tail_call_ssa" shape="call_ssa" placement="statement" sized="false" visit-order="dest output_expr params">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<builder params="output_exprs dest params dest_memory src_memory"/>
			<py operands="output dest_memory dest params src_memory" traits="tailcall ssa"/>
			<rust struct="CallSsa" operands="output_exprs dest params src_memory"/>
		</op>

		<op name="TAILCALL_UNTYPED_SSA" builder="tail_call_untyped_ssa" shape="call_ssa" placement="statement" sized="false" visit-order="dest output_expr param stack">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="param" part="CALL_PARAM_SSA"/>
			<operand name="stack" visited="false">
				<integer width="any"/>
			</operand>
			<builder params="output_exprs dest params dest_memory src_memory stack"/>
			<py operands="output dest_memory dest params src_memory stack" traits="tailcall ssa">
				<rename operand="src_memory" to="params_src_memory"/>
			</py>
			<rust struct="CallUntypedSsa" operands="output_exprs dest params stack"/>
		</op>

		<op name="CALL_PARAM_SSA" placement="part" exposes="params src_memory" sized="false">
			<operand name="src_memory" kind="memory_version"/>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<cpp>
				<parent-usage name="ParameterSSAMemoryVersion" operand="src_memory"/>
				<parent-usage name="UntypedParameterSSAExprs" operand="params"/>
			</cpp>
			<py mixin="_ParamListFormatting" traits="ssa">
				<rename operand="params" to="src"/>
			</py>
		</op>

		<op name="CALL_OUTPUT_SSA" placement="part" exposes="output_exprs dest_memory" sized="false">
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="output_exprs" kind="expr_list" items="VAR_OUTPUT_SSA VAR_OUTPUT_SSA_FIELD VAR_OUTPUT_ALIASED VAR_OUTPUT_ALIASED_FIELD STORE_OUTPUT RETURN_BY_REF"/>
			<cpp>
				<parent-usage name="OutputSSAMemoryVersion" operand="dest_memory"/>
				<parent-usage name="OutputExprsSubExpr" operand="output_exprs"/>
			</cpp>
			<py mixin="_CallOutputSsaVars" operands="dest_memory dest" traits="ssa">
				<rename operand="output_exprs" to="dest_exprs"/>
				<accessor name="dest" kind="ssa_variable_list"/>
			</py>
			<rust>
				<rename operand="output_exprs" to="output"/>
			</rust>
		</op>

		<op name="VAR_OUTPUT_SSA" placement="part">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<builder/>
			<py mixin="_VarOutputSsaVars" operands="var" traits="ssa_variable_instruction">
				<alias name="var" of="dest"/>
			</py>
		</op>

		<op name="VAR_OUTPUT_SSA_FIELD" placement="part">
			<operand name="var" kind="variable"/>
			<operand name="dest_version" kind="ssa_version" written="true"/>
			<operand name="prev_version" kind="ssa_version"/>
			<operand name="offset" kind="immediate"/>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_version"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_version"/>
			<builder/>
			<py mixin="_VarOutputFieldVars" traits="set_var ssa"/>
		</op>

		<op name="VAR_OUTPUT_ALIASED" placement="part">
			<operand name="var" kind="variable"/>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="prev_memory" kind="memory_version"/>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_memory"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_memory"/>
			<builder/>
			<py mixin="_VarOutputSsaVars" traits="set_var ssa"/>
		</op>

		<op name="VAR_OUTPUT_ALIASED_FIELD" placement="part">
			<operand name="var" kind="variable"/>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="prev_memory" kind="memory_version"/>
			<operand name="offset" kind="immediate"/>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_memory"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_memory"/>
			<builder/>
			<py mixin="_VarOutputFieldVars" traits="set_var ssa"/>
		</op>

		<op name="MEMORY_INTRINSIC_OUTPUT_SSA" placement="part" exposes="output dest_memory" sized="false">
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="output" kind="ssa_variable_list" written="true"/>
			<cpp>
				<parent-usage name="OutputSSAMemoryVersion" operand="dest_memory"/>
				<parent-usage name="OutputSSAVariablesSubExpr" operand="output"/>
			</cpp>
			<py mixin="_MemoryIntrinsicOutputSsaFormatting" traits="ssa"/>
		</op>

		<op name="LOAD_SSA"/>

		<op name="LOAD_STRUCT_SSA">
			<operand name="src">
				<integer width="any"/>
			</operand>
			<operand name="offset" kind="immediate"/>
			<operand name="src_memory" kind="memory_version"/>
			<result>
				<bits width="size"/>
			</result>
			<py traits="load ssa"/>
		</op>

		<op name="STORE_SSA"/>

		<op name="STORE_STRUCT_SSA" placement="statement">
			<operand name="dest">
				<integer width="any"/>
			</operand>
			<operand name="offset" kind="immediate"/>
			<operand name="dest_memory" kind="memory_version" written="true"/>
			<operand name="src_memory" kind="memory_version"/>
			<operand name="src">
				<bits width="size"/>
			</operand>
			<py traits="store ssa"/>
		</op>

		<op name="INTRINSIC_SSA" placement="statement" sized="false">
			<operand name="output" kind="ssa_variable_list" written="true"/>
			<operand name="intrinsic" kind="intrinsic"/>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<py mixin="_IntrinsicSsaVars" traits="ssa"/>
		</op>

		<op name="MEMORY_INTRINSIC_SSA" placement="statement" sized="false">
			<operand name="output_expr" part="MEMORY_INTRINSIC_OUTPUT_SSA"/>
			<operand name="intrinsic" kind="intrinsic"/>
			<operand name="params" kind="expr_list">
				<bits width="any"/>
			</operand>
			<operand name="src_memory" kind="memory_version"/>
			<builder params="output intrinsic params dest_memory src_memory"/>
			<py mixin="_IntrinsicSsaVars" traits="ssa"/>
			<rust operands="output_expr intrinsic params src_memory">
				<rename operand="output_expr" to="output"/>
			</rust>
		</op>

		<op name="FREE_VAR_SLOT_SSA" placement="statement" sized="false">
			<operand name="var" kind="variable"/>
			<operand name="dest_version" kind="ssa_version" written="true"/>
			<operand name="prev_version" kind="ssa_version"/>
			<pair name="dest" kind="ssa_variable" of="var" version="dest_version"/>
			<pair name="prev" kind="ssa_variable" of="var" version="prev_version"/>
			<py traits="ssa register_stack"/>
		</op>

		<op name="VAR_PHI" placement="statement" sized="false">
			<operand name="dest" kind="ssa_variable" written="true"/>
			<operand name="src" kind="ssa_variable_list"/>
			<py mixin="_VarPhiVars" traits="set_var phi ssa"/>
			<rust>
				<list operand="src" item="operand"/>
			</rust>
		</op>

		<op name="MEM_PHI">
			<rust>
				<list operand="src_memory" item="operand"/>
			</rust>
		</op>
	</group>

	<op name="BLOCK_TO_EXPAND" placement="statement" sized="false">
		<doc>Holds instructions that a later workflow step expands in its place</doc>
		<description>Holds the statements <ref name="src"/> until a later analysis step expands them in
			place of this instruction.</description>
		<form>{ <ref name="src"/> }</form>
		<operand name="src" kind="expr_list">
			<statement/>
			<description>The statements</description>
		</operand>
		<cpp>
			<setter operand="src"/>
		</cpp>
		<py>
			<rename operand="src" to="exprs"/>
		</py>
		<rust>
			<rename operand="src" to="exprs"/>
			<list operand="src" item="operand"/>
		</rust>
	</op>

